{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "octroi-common baseline",
  "description": "Documented JSON-Schema fragment for the value shape every octroi-common helper reads. This file is not itself validated by Helm (a library chart's values.schema.json is never evaluated — only an installable chart's is) — it is the copy-forward template each consuming chart's own values.schema.json starts from. Keep the two in lockstep by hand; see values.yaml for the narrative version of the same contract.",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": ["registry", "repository"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "brick": { "type": "string" },
    "existingSecret": { "type": "string" },
    "managementPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" },
        "hookWeight": { "type": ["integer", "string", "null"] }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "probes": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "readinessInitialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
